<%- include('../partials/top', { title, active: 'products' }) %>
  <div class="pagehead">
    <div>
      <div class="pagehead__titleline">
        <h1 class="h1">Edit Produk</h1>
        <a class="btn btn--back btn--small pagehead__back" href="/products">Kembali</a>
      </div>
      <div class="muted">Perbarui data produk</div>
    </div>
  </div>

  <% if (errors && errors.length) { %>
    <div class="flash flash--error">
      <div class="flash__title">Periksa input:</div>
      <ul class="list">
        <% errors.forEach((e) => { %>
          <li><%= e %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <form class="card formstack" method="post" action="/products/<%= form.id %>?_method=PUT">
    <div class="field">
      <label class="label">Nama produk</label>
      <input class="input" name="name" value="<%= form.name || '' %>" required />
    </div>
    <div class="field">
      <label class="label">Kategori</label>
      <select class="select" name="category_id" required>
        <% categories.forEach((c) => { %>
          <option value="<%= c.id %>" <%= String(form.category_id) === String(c.id) ? 'selected' : '' %>><%= c.name %></option>
        <% }) %>
      </select>
    </div>
    <div class="field">
      <label class="label">Harga (Rupiah)</label>
      <input class="input" name="price" type="number" min="0" step="1" value="<%= form.price %>" required />
    </div>
    <div class="field">
      <label class="label">Stock Awal</label>
      <input class="input" name="initial_stock" type="number" min="0" step="1" value="<%= form.initial_stock %>" required />
    </div>
    <div class="field">
      <label class="label">Stock Saat Ini</label>
      <input class="input" name="stock" type="number" min="0" step="1" value="<%= form.stock %>" required />
    </div>
    <div class="field">
      <label class="label">Aktif?</label>
      <select class="select" name="is_active">
        <option value="1" <%= String(form.is_active) !== '0' ? 'selected' : '' %>>Aktif</option>
        <option value="0" <%= String(form.is_active) === '0' ? 'selected' : '' %>>Nonaktif</option>
      </select>
    </div>
    <div class="actions">
      <button class="btn btn--primary" type="submit">Simpan</button>
    </div>
  </form>
<%- include('../partials/bottom') %>
