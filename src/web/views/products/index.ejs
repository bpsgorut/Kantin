<%- include('../partials/top', { title, active: 'products' }) %>
  <div class="pagehead">
    <div>
      <h1 class="h1">Produk</h1>
      <div class="muted">Kelola daftar barang yang dijual di kantin</div>
    </div>
    <div class="pagehead__actions">
      <a class="btn btn--primary" href="/products/new">Tambah Produk</a>
    </div>
  </div>

  <%- include('../partials/flash', { msg, msgType }) %>

  <div class="card">
    <div class="card__title">Daftar Produk</div>
    <div class="tablewrap tablewrap--stack">
      <table class="table table--stack">
        <thead>
          <tr>
            <th>Nama</th>
            <th>Kategori</th>
            <th>Harga</th>
            <th>Stock Awal</th>
            <th>Stock Saat Ini</th>
            <th>Status</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% if (!products.length) { %>
            <tr>
              <td colspan="7" class="muted">Belum ada produk. Tambahkan dulu.</td>
            </tr>
          <% } %>
          <% products.forEach((p) => { %>
            <tr>
              <td data-label="Nama"><%= p.name %></td>
              <td data-label="Kategori"><%= p.category_name %></td>
              <td class="nowrap" data-label="Harga"><%= formatRupiah(p.price) %></td>
              <td data-label="Stock Awal"><%= p.initial_stock %></td>
              <td data-label="Stock Saat Ini"><%= p.stock %></td>
              <td data-label="Status">
                <% if (p.stock > 0) { %>
                  <span class="badge badge--success">Aktif</span>
                <% } else { %>
                  <span class="badge badge--muted">Habis</span>
                <% } %>
              </td>
              <td class="nowrap" data-label="">
                <form class="inline js-refill-form" method="post" action="/products/<%= p.id %>/refill?_method=PUT">
                  <input type="hidden" name="qty" value="" />
                  <button class="btn btn--small js-refill-btn" type="button" data-product-name="<%= p.name %>">Refill</button>
                </form>
                <form class="inline" method="post" action="/products/<%= p.id %>/reset?_method=PUT" onsubmit="return confirm('Reset data produk <%= p.name %>? Stock awal dan stock saat ini akan jadi 0, lalu status menjadi habis.');">
                  <button class="btn btn--small" type="submit">Reset</button>
                </form>
                <a class="btn btn--small" href="/products/<%= p.id %>/edit">Edit</a>
                <form class="inline" method="post" action="/products/<%= p.id %>?_method=DELETE" onsubmit="return confirm('Hapus produk ini?');">
                  <button class="btn btn--small btn--danger" type="submit">Hapus</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <script>
    (() => {
      const buttons = document.querySelectorAll(".js-refill-btn");
      for (const btn of buttons) {
        btn.addEventListener("click", () => {
          const form = btn.closest(".js-refill-form");
          if (!form) return;
          const productName = btn.getAttribute("data-product-name") || "produk ini";
          const raw = window.prompt(`Refill stock untuk ${productName}\nMasukkan jumlah stock yang ditambahkan:`, "1");
          if (raw === null) return;
          const qty = Number.parseInt(String(raw).trim(), 10);
          if (!Number.isFinite(qty) || qty <= 0) return;
          const input = form.querySelector('input[name="qty"]');
          if (!input) return;
          input.value = String(qty);
          form.submit();
        });
      }
    })();
  </script>
<%- include('../partials/bottom') %>
